{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$room": {
        ".read": "auth != null && $room === 'main'",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $room === 'main'",
          ".validate": "newData.hasChildren(['n','c','x','y','d','t'])",
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
          "c": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000" },
          "d": { ".validate": "newData.isString() && newData.val().matches(/^(up|down|left|right)$/)" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "e": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12" },
          "et": { ".validate": "newData.isNumber()" },
          "q": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 16" },
          "qt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "config": {
      "chat": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'oMuzhTQifgeftCT7SblXF34zeq13'",
        ".validate": "newData.hasChildren(['on','t'])",
        "on": { ".validate": "newData.isBoolean()" },
        "t": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "chatLast": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || now - data.val() >= 2500)"
      }
    },
    "chat": {
      "$room": {
        ".read": "auth != null && $room === 'main' && (root.child('config/chat/on').val() === true || auth.uid === 'oMuzhTQifgeftCT7SblXF34zeq13')",
        ".write": "auth != null && $room === 'main' && auth.uid === 'oMuzhTQifgeftCT7SblXF34zeq13'",
        "$id": {
          ".write": "auth != null && $room === 'main' && !data.exists() && newData.exists() && root.child('config/chat/on').val() === true",
          ".validate": "newData.hasChildren(['u','n','m','t']) && newData.child('u').val() === auth.uid && newData.parent().parent().parent().child('chatLast').child(auth.uid).val() === now",
          "u": { ".validate": "newData.isString()" },
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
          "m": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "t": { ".validate": "newData.val() === now" },
          "a": { ".validate": "newData.val() === true && auth.uid === 'oMuzhTQifgeftCT7SblXF34zeq13'" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
